+    /// <summary>
+    /// Per-instance hosts file used on Linux in place of /etc/hosts. The
+    /// epinelps-launcher wrapper exports EPINELPS_HOSTS_FILE for it.
+    /// </summary>
+    public static string PrivateHostsFile
+    {
+        get
+        {
+            string? explicitPath = Environment.GetEnvironmentVariable("EPINELPS_HOSTS_FILE");
+            if (!string.IsNullOrEmpty(explicitPath)) return explicitPath;
+
+            string? dataDir = Environment.GetEnvironmentVariable("EPINELPS_DATA");
+            if (string.IsNullOrEmpty(dataDir))
+            {
+                string? xdgData = Environment.GetEnvironmentVariable("XDG_DATA_HOME");
+                dataDir = string.IsNullOrEmpty(xdgData)
+                    ? Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".local", "share", "EpinelPS")
+                    : Path.Combine(xdgData, "EpinelPS");
+            }
+
+            return Path.Combine(dataDir, "hosts");
+        }
+    }
+
