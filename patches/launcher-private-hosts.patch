+    /// <summary>
+    /// Creates the Linux private hosts file from the system one on first use,
+    /// so the game keeps normal name resolution plus the redirect block.
+    /// </summary>
+    private static async Task SeedPrivateHostsFile(string filePath)
+    {
+        try
+        {
+            string? dir = Path.GetDirectoryName(filePath);
+            if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+
+            string seed = File.Exists("/etc/hosts") ? await File.ReadAllTextAsync("/etc/hosts") : "";
+            await File.WriteAllTextAsync(filePath, seed);
+        }
+        catch (Exception ex)
+        {
+            throw new Exception($"Cannot create private hosts file \"{filePath}\"", ex);
+        }
+    }
